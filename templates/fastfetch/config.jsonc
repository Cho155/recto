// Recto · fastfetch ({{ theme_name }})
// Generated by tools/recto-theme. Edit templates/fastfetch/config.jsonc instead.
//
// The logo is the distribution's own mark (Arch ships it in
// /usr/share/pixmaps) in solid clay: a sixel picture that recto-theme draws at
// login for the screen's scale. Without it, fastfetch uses its built-in text
// logo in the same clay.
// Keys are italic clay, like the rubricated headings of a printed page.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "raw",
    "source": "{{ paths.cache_abs }}/fastfetch-{{ theme_name }}.six",
    "width": {{ terminal.logo_columns }},
    "height": {{ terminal.logo_rows }},
    "color": { "1": "{{ t.accent }}", "2": "{{ t.accent }}" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "brightColor": false,
    "disableLinewrap": true,
    "key": { "width": 12 },
    "color": {
      "keys": "italic_{{ t.accent_text }}",
      "title": "{{ t.text }}",
      "separator": "{{ t.muted }}"
    }
  },
  "modules": [
    { "type": "title", "color": { "user": "{{ t.text }}", "at": "{{ t.muted }}", "host": "{{ t.text }}" } },
    { "type": "separator", "string": "─", "outputColor": "{{ t.mark }}" },
    { "type": "os", "key": "System", "format": "{name}" },
    { "type": "kernel", "key": "Kernel", "format": "{release}" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "wm", "key": "Compositor" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "terminalfont", "key": "Type", "format": "{name} {size}" },
    { "type": "cpu", "key": "Processor", "format": "{name}" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery", "key": "Battery" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
