<?xml version="1.0" encoding="UTF-8"?>
<!--
  Recto · GtkSourceView scheme ({{ theme_name }})
  Generated by tools/recto-theme. Edit templates/gtksourceview/recto.xml instead.

  Set like a printed page: almost everything in ink; structure in bold,
  comments in italic; a few quiet colors from the terminal palette; clay
  only for list markers, like rubrication in the margin.
-->
<style-scheme id="recto{{ t.scheme | if_dark(-dark) }}" name="Recto · {{ theme_name }}" version="1.0">
  <author>Recto</author>
  <description>Paper and Ink, from Recto's design tokens</description>
  <metadata>
    <property name="variant">{{ t.scheme }}</property>
    <property name="light-variant">recto</property>
    <property name="dark-variant">recto-dark</property>
  </metadata>

  <!-- The page -->
  <style name="text"                 foreground="{{ t.text }}" background="{{ t.base }}"/>
  <style name="background-pattern"   background="{{ t.raised }}"/>
  <style name="selection"            foreground="{{ t.text }}" background="{{ t.selection }}"/>
  <style name="selection-unfocused"  foreground="{{ t.text }}" background="{{ t.raised }}"/>
  <style name="cursor"               foreground="{{ t.cursor }}"/>
  <style name="secondary-cursor"     foreground="{{ t.muted }}"/>
  <style name="current-line"         background="{{ t.raised }}"/>
  <style name="line-numbers"         foreground="{{ t.mark }}" background="{{ t.base }}"/>
  <style name="current-line-number"  foreground="{{ t.text }}" background="{{ t.raised }}"/>
  <style name="right-margin"         foreground="{{ t.line }}" background="{{ t.line }}"/>
  <style name="draw-spaces"          foreground="{{ t.quiet }}"/>
  <style name="bracket-match"        bold="true" underline="single"/>
  <style name="bracket-mismatch"     foreground="{{ t.danger }}" underline="single"/>
  <style name="search-match"         foreground="{{ t.text }}" background="{{ t.selection }}" bold="true"/>
  <style name="map-overlay"          background="{{ t.mark }}"/>

  <!-- Prose (Markdown and friends): the shape of a book -->
  <style name="def:heading"          foreground="{{ t.text }}" bold="true"/>
  <style name="def:emphasis"         italic="true"/>
  <style name="def:strong-emphasis"  bold="true"/>
  <style name="def:underlined"       underline="single"/>
  <style name="def:list-marker"      foreground="{{ t.accent_text }}" bold="true"/>
  <style name="def:link-text"        foreground="{{ t.info }}"/>
  <style name="def:link-destination" foreground="{{ t.muted }}" italic="true" underline="low"/>
  <style name="def:net-address"      foreground="{{ t.info }}" underline="low"/>
  <style name="def:inline-code"      foreground="{{ t.ansi.cyan }}"/>
  <style name="def:preformatted-section" foreground="{{ t.ansi.cyan }}"/>
  <style name="def:blockquote"       foreground="{{ t.muted }}" italic="true"/>
  <style name="def:note"             foreground="{{ t.warning }}" bold="true"/>

  <!-- Code: ink, with structure in bold -->
  <style name="def:comment"          foreground="{{ t.muted }}" italic="true"/>
  <style name="def:shebang"          foreground="{{ t.muted }}" bold="true"/>
  <style name="def:doc-comment-element" foreground="{{ t.muted }}" italic="true" bold="true"/>
  <style name="def:keyword"          foreground="{{ t.text }}" bold="true"/>
  <style name="def:statement"        foreground="{{ t.text }}" bold="true"/>
  <style name="def:builtin"          foreground="{{ t.text }}" bold="true"/>
  <style name="def:type"             foreground="{{ t.ansi.blue }}"/>
  <style name="def:function"         foreground="{{ t.text }}"/>
  <style name="def:identifier"       foreground="{{ t.text }}"/>
  <style name="def:string"           foreground="{{ t.ansi.green }}"/>
  <style name="def:special-char"     foreground="{{ t.ansi.green }}" bold="true"/>
  <style name="def:constant"         foreground="{{ t.ansi.magenta }}"/>
  <style name="def:number"           foreground="{{ t.ansi.magenta }}"/>
  <style name="def:boolean"          foreground="{{ t.ansi.magenta }}"/>
  <style name="def:preprocessor"     foreground="{{ t.ansi.yellow }}"/>
  <style name="def:special-constant" foreground="{{ t.ansi.magenta }}"/>
  <style name="def:error"            underline="error" underline-color="{{ t.danger }}"/>
  <style name="def:warning"          underline="error" underline-color="{{ t.warning }}"/>
  <style name="def:deletion"         strikethrough="true"/>

  <!-- Diffs -->
  <style name="diff:added-line"      foreground="{{ t.success }}"/>
  <style name="diff:removed-line"    foreground="{{ t.danger }}"/>
  <style name="diff:changed-line"    foreground="{{ t.warning }}"/>
  <style name="diff:location"        foreground="{{ t.muted }}" italic="true"/>
  <style name="diff:diff-file"       foreground="{{ t.text }}" bold="true"/>
</style-scheme>
