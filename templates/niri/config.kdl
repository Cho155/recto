// Recto · niri configuration
// Generated by tools/recto-theme from design/tokens.toml and templates/niri/config.kdl.
// Edit the template, not this file. Personal settings (outputs, keyboard layout,
// extra binds) belong in {{ paths.config }}/niri/local.kdl, which is included last.
// Colors live in the theme file included near the end, so switching between
// Paper and Ink swaps only that file.

input {
    keyboard {
        xkb {
            // Empty: niri reads the layout from org.freedesktop.locale1.
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps {{ shape.gap }}
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // One quiet clay ring around the focused window; no borders elsewhere.
    focus-ring {
        width {{ shape.focus_ring }}
    }
    border {
        off
    }

    // Shadows separate windows from the paper, instead of borders.
    shadow {
        on
        softness {{ shadow.softness }}
        spread {{ shadow.spread }}
        offset x=0 y={{ shadow.offset_y }}
    }
}

// Ask apps to leave decorations to niri: terminals lose their title bars,
// and the focus ring is drawn around windows rather than behind them.
prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

// Opening and closing ease out. Movement a gesture can drive uses a
// critically damped spring, so it follows the finger and never overshoots.
animations {
    workspace-switch {
        spring damping-ratio={{ motion.spring_damping }} stiffness={{ motion.spring_stiffness }} epsilon={{ motion.spring_epsilon }}
    }
    horizontal-view-movement {
        spring damping-ratio={{ motion.spring_damping }} stiffness={{ motion.spring_stiffness }} epsilon={{ motion.spring_epsilon }}
    }
    window-movement {
        spring damping-ratio={{ motion.spring_damping }} stiffness={{ motion.spring_stiffness }} epsilon={{ motion.spring_epsilon }}
    }
    window-resize {
        spring damping-ratio={{ motion.spring_damping }} stiffness={{ motion.spring_stiffness }} epsilon={{ motion.spring_epsilon }}
    }
    overview-open-close {
        spring damping-ratio={{ motion.spring_damping }} stiffness={{ motion.spring_stiffness }} epsilon={{ motion.spring_epsilon }}
    }
    // A window settles like a sheet of paper laid on the desk: it starts a little
    // larger, as if held just above the page, and fades in as it comes down.
    // Closing lifts it away. The texture includes the shadow, so it moves too.
    window-open {
        duration-ms {{ motion.duration_long }}
        curve "{{ motion.easing }}"
        custom-shader r#"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = 1.0 + {{ motion.window_lift }} * (1.0 - p);
                vec3 coords = vec3((coords_geo.xy - 0.5) / scale + 0.5, 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords;
                if (any(lessThan(coords_tex.xy, vec2(0.0))) || any(greaterThan(coords_tex.xy, vec2(1.0))))
                    return vec4(0.0);
                return texture2D(niri_tex, coords_tex.st) * p;
            }
        "#
    }
    window-close {
        duration-ms {{ motion.duration_short }}
        curve "{{ motion.easing }}"
        custom-shader r#"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = 1.0 + {{ motion.window_lift }} * p;
                vec3 coords = vec3((coords_geo.xy - 0.5) / scale + 0.5, 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords;
                if (any(lessThan(coords_tex.xy, vec2(0.0))) || any(greaterThan(coords_tex.xy, vec2(1.0))))
                    return vec4(0.0);
                return texture2D(niri_tex, coords_tex.st) * (1.0 - p);
            }
        "#
    }
}

// Same corners for every window, and keep translucent windows translucent
// when focused (the ring is not painted behind them).
window-rule {
    geometry-corner-radius {{ shape.radius_window }}
    clip-to-geometry true
    draw-border-with-background false
}

// The active window sits a little higher on the desk: a softer, deeper shadow
// (its color is in the theme file). Focus shows in depth, not only in the ring.
window-rule {
    match is-active=true
    shadow {
        softness {{ shadow.lift_softness }}
        offset x=0 y={{ shadow.lift_offset_y }}
    }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// The launcher (fuzzel) and mako, when they stand in for the shell, float with a soft shadow.
// The shell's own panels draw their shadows themselves, so the shadow moves with them.
layer-rule {
    match namespace="^notifications$"
    match namespace="^launcher$"
    geometry-corner-radius {{ shape.radius_panel }}
    shadow {
        on
    }
}

// Qt 6 apps take Recto's palette and fonts through qt6ct, when it is installed
// (without it Qt prints a warning and keeps its defaults).
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
}

spawn-at-startup "foot" "--server"
spawn-sh-at-startup "{{ paths.data }}/bin/recto-theme session-start"
spawn-sh-at-startup "{{ paths.data }}/bin/recto-shell"

// Lock after a while, then turn the displays off; lock before sleeping.
spawn-sh-at-startup "command -v swayidle >/dev/null && exec swayidle -w timeout {{ session.lock_after_seconds }} '{{ paths.data }}/bin/recto-theme lock' timeout {{ session.screen_off_after_seconds }} 'niri msg action power-off-monitors' before-sleep '{{ paths.data }}/bin/recto-theme lock'"

// Password prompts for administrator actions (a GTK 3 dialog in Recto's colors).
spawn-sh-at-startup "agent=/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; [ -x $agent ] && exec $agent"

binds {
    Mod+Shift+Slash hotkey-overlay-title="Show these keys" { show-hotkey-overlay; }

    // A window of foot's server; a foot of its own only when the server is not
    // there. --no-wait returns at once: without it footclient passes on the
    // shell's exit status, and closing the window would open another terminal.
    Mod+Return hotkey-overlay-title="Open a terminal (also Super+T)" { spawn-sh "footclient --no-wait || foot"; }
    Mod+T { spawn-sh "footclient --no-wait || foot"; }
    Mod+Space hotkey-overlay-title="Search apps and actions (also Super+D)" { spawn-sh "{{ paths.data }}/bin/recto-shell toggle-search"; }
    Mod+D { spawn-sh "{{ paths.data }}/bin/recto-shell toggle-search"; }
    Mod+A hotkey-overlay-title="Today: notifications, theme, focus" { spawn-sh "{{ paths.data }}/bin/recto-shell toggle-today"; }
    Mod+N hotkey-overlay-title="Wi‑Fi and network" { spawn-sh "{{ paths.data }}/bin/recto-shell toggle-network"; }
    Mod+B hotkey-overlay-title="Bluetooth" { spawn-sh "{{ paths.data }}/bin/recto-shell toggle-bluetooth"; }
    Mod+S hotkey-overlay-title="Sound: volume and devices" { spawn-sh "{{ paths.data }}/bin/recto-shell toggle-sound"; }
    Mod+Shift+T hotkey-overlay-title="Switch between Paper and Ink" { spawn-sh "{{ paths.data }}/bin/recto-theme toggle"; }
    Super+Alt+L hotkey-overlay-title="Lock the screen" { spawn-sh "{{ paths.data }}/bin/recto-theme lock"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "{{ paths.data }}/bin/recto-shell volume up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "{{ paths.data }}/bin/recto-shell volume down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "{{ paths.data }}/bin/recto-shell volume mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "{{ paths.data }}/bin/recto-shell mic-mute"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "{{ paths.data }}/bin/recto-shell brightness up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "{{ paths.data }}/bin/recto-shell brightness down"; }

    Mod+O hotkey-overlay-title="Overview of all windows" repeat=false { toggle-overview; }
    Mod+Q hotkey-overlay-title="Close the window" repeat=false { close-window; }

    Mod+Left hotkey-overlay-title="Focus the column to the left" { focus-column-left; }
    Mod+Right hotkey-overlay-title="Focus the column to the right" { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Ctrl+Left hotkey-overlay-title="Move the column left" { move-column-left; }
    Mod+Ctrl+Right hotkey-overlay-title="Move the column right" { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }

    Mod+Home      { focus-column-first; }
    Mod+End       { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }

    Mod+Page_Down hotkey-overlay-title="Next workspace (also Super+U)" { focus-workspace-down; }
    Mod+Page_Up hotkey-overlay-title="Previous workspace (also Super+I)" { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down hotkey-overlay-title="Move the column to the next workspace" { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up hotkey-overlay-title="Move the column to the previous workspace" { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    Mod+1 hotkey-overlay-title="Go to workspace 1 to 9" { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 hotkey-overlay-title="Move the column to workspace 1 to 9" { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+BracketLeft hotkey-overlay-title="Join or leave the column to the left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Join or leave the column to the right" { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R hotkey-overlay-title="Cycle the column width" { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }
    Mod+F hotkey-overlay-title="Maximize the column" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    Mod+C hotkey-overlay-title="Center the column" { center-column; }
    Mod+Minus hotkey-overlay-title="Narrow the column (Super+= widens it)" { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V hotkey-overlay-title="Float or tile the window" { toggle-window-floating; }
    Mod+Shift+V hotkey-overlay-title="Move focus between floating and tiled" { switch-focus-between-floating-and-tiling; }
    Mod+W hotkey-overlay-title="Show the column as tabs" { toggle-column-tabbed-display; }

    Print hotkey-overlay-title="Screenshot of an area (Ctrl: screen, Alt: window)" { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E hotkey-overlay-title="Log out" { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P hotkey-overlay-title="Turn the displays off" { power-off-monitors; }
}

include optional=true "{{ paths.data }}/current/niri/theme.kdl"
include optional=true "{{ paths.config }}/niri/local.kdl"
