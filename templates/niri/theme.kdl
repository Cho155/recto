// Recto · niri colors ({{ theme_name }})
// Generated by tools/recto-theme. Included by the main config; holds colors only.

layout {
    background-color "{{ t.wallpaper }}"

    focus-ring {
        active-color "{{ t.accent }}"
        inactive-color "{{ t.line }}"
    }
    border {
        urgent-color "{{ t.danger }}"
    }
    shadow {
        color "{{ t.shadow_lift }}"
        inactive-color "{{ t.shadow }}"
    }
    insert-hint {
        color "{{ t.accent | hash_alpha(0.35) }}"
    }
}

overview {
    backdrop-color "{{ t.backdrop }}"
}
