# Liubai · mako ({{ theme_name }})
# Generated by tools/liubai-theme. Edit templates/mako/config instead.
# Notifications sit in the right margin: small, quiet, no icons.
# `makoctl mode -a focus` holds them; critical ones still come through.

font={{ font.serif }} {{ font.pt.notification }}
anchor=top-right
layer=top
width=320
height=160
outer-margin={{ shape.gap }}
margin=0,0,8
padding=14,16,16
border-size={{ shape.hairline }}
border-radius={{ shape.radius_panel }}
background-color={{ t.base }}
text-color={{ t.text }}
border-color={{ t.line }}
progress-color=over {{ t.raised }}
icons=0
markup=1
format=<span size="small" foreground="{{ t.muted }}">%a</span>\n<b>%s</b>\n<span foreground="{{ t.muted }}">%b</span>
default-timeout=6000
max-visible=3
history=1
max-history=50

[urgency=critical]
border-color={{ t.accent }}
default-timeout=0

[mode=focus]
invisible=1

[mode=focus urgency=critical]
invisible=0
