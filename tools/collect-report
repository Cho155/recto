#!/usr/bin/env python3
"""collect-report: gather what a real-machine test of Recto needs, in one folder.

Run it inside a Recto session (niri with recto-shell), with one terminal open
and nothing else. It takes about three minutes; leave the machine alone while
it runs. The bar blinks twice: the shell is restarted once to time its frames.

  tools/collect-report               writes reports/real-hardware/<date>-<time>/
  tools/collect-report --out DIR

What it writes:
  system.json     OS, kernel, CPU, memory, GPU and driver, screens and scale, versions
  memory-*.json   the desktop's memory: idle, Today open, 30 s after closing it
  frames.json     frame timing while Today, Search, a notification and the OSD
                  open and close (GTK's own frame log), with software drawing
                  (cairo, the default) and with the GPU (gl), to compare
  summary.md      the numbers in short

Nothing personal is collected beyond the machine's model and its screens.
Look the folder over before you share it.

Needs Python 3.11 or newer and nothing outside the standard library.
"""

import argparse
import json
import os
import re
import shutil
import statistics
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
DATA = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "recto"
SHELL = DATA / "bin" / "recto-shell"
MEASURE = HERE / "measure-memory"


def run(cmd, timeout=10):
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return res.stdout.strip() if res.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return None


def step(text):
    print(f"\n{text}", flush=True)


# ── system ────────────────────────────────────────────────────────────────

def gpus():
    found = []
    for card in sorted(Path("/sys/class/drm").glob("card[0-9]*")):
        dev = card / "device"
        if "-" in card.name or not dev.exists():
            continue   # connectors like card0-eDP-1
        driver = dev / "driver"
        found.append({
            "card": card.name,
            "vendor": read(dev / "vendor"),
            "device": read(dev / "device"),
            "driver": os.path.basename(os.readlink(driver)) if driver.is_symlink() else None,
            "boot_vga": read(dev / "boot_vga") == "1",
        })
    return found


def screens():
    out = run(["niri", "msg", "--json", "outputs"])
    try:
        data = json.loads(out or "{}")
    except json.JSONDecodeError:
        return []
    result = []
    for name, o in (data.items() if isinstance(data, dict) else []):
        modes, current = o.get("modes") or [], o.get("current_mode")
        mode = modes[current] if isinstance(current, int) and current < len(modes) else {}
        logical = o.get("logical") or {}
        result.append({
            "name": name,
            "make": o.get("make"),
            "model": o.get("model"),
            "pixels": [mode.get("width"), mode.get("height")],
            "refresh_hz": round(mode.get("refresh_rate", 0) / 1000, 2) if mode.get("refresh_rate") else None,
            "scale": logical.get("scale"),
            "logical": [logical.get("width"), logical.get("height")],
        })
    return result


def system_info():
    osr = {}
    for line in (read("/etc/os-release") or "").splitlines():
        key, _, value = line.partition("=")
        osr[key] = value.strip('"')
    cpu = next((l.split(":", 1)[1].strip() for l in (read("/proc/cpuinfo") or "").splitlines()
                if l.startswith("model name")), None)
    mem = next((int(l.split()[1]) for l in (read("/proc/meminfo") or "").splitlines()
                if l.startswith("MemTotal:")), None)
    packages = run(["pacman", "-Q", "niri", "gtk4", "pango", "cairo", "mesa", "foot"]) if shutil.which("pacman") else None
    return {
        "os": osr.get("PRETTY_NAME"),
        "kernel": run(["uname", "-r"]),
        "machine": " ".join(filter(None, [read("/sys/class/dmi/id/sys_vendor"),
                                          read("/sys/class/dmi/id/product_name")])) or None,
        "cpu": cpu,
        "memory_mib": round(mem / 1024) if mem else None,
        "battery": any(Path("/sys/class/power_supply").glob("BAT*")),
        "gpus": gpus(),
        "screens": screens(),
        "niri": run(["niri", "--version"]),
        "foot": run(["foot", "--version"]),
        "gtk4": run(["pkg-config", "--modversion", "gtk4"]),
        "packages": packages.splitlines() if packages else None,
        "recto_commit": run(["git", "-C", str(REPO), "rev-parse", "--short", "HEAD"]),
        "gsk_renderer": os.environ.get("GSK_RENDERER") or "cairo (the shell's default)",
    }


# ── memory ────────────────────────────────────────────────────────────────

def measure(out, name, label):
    subprocess.run([sys.executable, str(MEASURE), "--label", label, "--json", str(out / f"memory-{name}.json")],
                   stdout=subprocess.DEVNULL, check=False)
    try:
        return json.loads((out / f"memory-{name}.json").read_text())
    except (OSError, json.JSONDecodeError):
        return None


def shell(*args):
    subprocess.run([str(SHELL), *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


# ── frames ────────────────────────────────────────────────────────────────

FRAME = re.compile(r"interval=([\d.]+).*?refresh_interval=([\d.]+)")


def start_shell(env_extra=None, log=None):
    env = dict(os.environ, **(env_extra or {}))
    sink = open(log, "w") if log else subprocess.DEVNULL
    subprocess.Popen([str(SHELL)], env=env, stdin=subprocess.DEVNULL, stdout=sink, stderr=sink,
                     start_new_session=True)


def stop_shell():
    shell("quit")
    time.sleep(0.8)


def frames_of(lines):
    intervals, refresh = [], []
    for line in lines:
        m = FRAME.search(line)
        if m:
            i, r = float(m.group(1)), float(m.group(2))
            # Over 200 ms is a pause between motions (the panel sat still), not a slow
            # frame; GDK also prints wrapped negatives as huge numbers. Skip both.
            if 0 < i < 200:
                intervals.append(i)
            refresh.append(r)
    if not intervals:
        return None
    hz = statistics.median(refresh) if refresh else None
    ordered = sorted(intervals)
    return {
        "frames": len(intervals),
        "refresh_interval_ms": hz,
        "interval_median_ms": round(statistics.median(ordered), 1),
        "interval_p90_ms": round(ordered[int(0.9 * (len(ordered) - 1))], 1),
        "interval_max_ms": round(ordered[-1], 1),
        "late_frames": sum(1 for i in intervals if hz and i > 1.5 * hz),
    }


def notify():
    run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
         "--object-path", "/org/freedesktop/Notifications",
         "--method", "org.freedesktop.Notifications.Notify",
         "Recto test", "0", "", "Frame timing", "A note to time its motion.", "[]", "{}", "3000"])


def time_frames(out, renderer):
    log = out / f"frames-{renderer}.log"
    stop_shell()
    start_shell({"GDK_DEBUG": "frames", "GSK_RENDERER": renderer}, log)
    time.sleep(2.5)
    scenes = [
        ("today", [("toggle-today",), 1.2, ("toggle-today",), 0.8]),
        ("search", [("toggle-search",), 1.2, ("toggle-search",), 0.8]),
        ("notification", [notify, 4.5]),
        ("osd", [("volume", "up"), 0.4, ("volume", "down"), 2.0]),
    ]
    result = {}
    for name, script in scenes:
        before = len(log.read_text(errors="replace").splitlines())
        for item in script:
            if isinstance(item, float):
                time.sleep(item)
            elif callable(item):
                item()
            else:
                shell(*item)
        lines = log.read_text(errors="replace").splitlines()[before:]
        result[name] = frames_of(lines)
    stop_shell()
    return result


# ── summary ───────────────────────────────────────────────────────────────

def mib(kib):
    return f"{kib / 1024:.1f}" if isinstance(kib, (int, float)) else "–"


def proc(mem, name, field="pss_kib"):
    if not mem:
        return None
    total = sum(p.get(field, 0) for p in mem.get("processes", []) if p.get("name") == name)
    return total or None


def summary(info, mems, frames):
    lines = ["# Recto on real hardware", ""]
    lines.append(f"- Machine: {info.get('machine') or '–'}; {info.get('cpu') or '–'}; "
                 f"{info.get('memory_mib') or '–'} MiB")
    lines.append(f"- OS: {info.get('os') or '–'}, kernel {info.get('kernel') or '–'}")
    for g in info.get("gpus") or []:
        lines.append(f"- GPU {g['card']}: {g['vendor']}:{g['device']}, driver {g['driver']}")
    for s in info.get("screens") or []:
        lines.append(f"- Screen {s['name']}: {s['pixels'][0]}×{s['pixels'][1]} at {s['refresh_hz']} Hz, "
                     f"scale {s['scale']}")
    lines.append(f"- {info.get('niri') or 'niri ?'}; Recto {info.get('recto_commit') or '?'}; "
                 f"renderer {info.get('gsk_renderer')}")
    lines += ["", "## Memory (PSS, MiB)", "",
              "| Moment | Whole desktop | Shell | Shell RSS | niri |", "| --- | --- | --- | --- | --- |"]
    for name, label in (("idle", "Idle"), ("today", "Today open"), ("after", "30 s after closing")):
        m = mems.get(name)
        lines.append(f"| {label} | {mib((m or {}).get('desktop_pss_kib'))} | {mib(proc(m, 'recto-shell'))} "
                     f"| {mib(proc(m, 'recto-shell', 'rss_kib'))} | {mib(proc(m, 'niri'))} |")
    lines += ["", "Budget: whole desktop ≤ 400, shell ≤ 100; first-open caches ≤ 5 over idle.", "",
              "## Frames while panels open and close (ms between frames)", "",
              "| Panel | Drawing | Frames | Screen refresh | Median | 90 % | Longest | Late frames |",
              "| --- | --- | --- | --- | --- | --- | --- | --- |"]
    for renderer, scenes in frames.items():
        for name, f in scenes.items():
            if f:
                lines.append(f"| {name} | {renderer} | {f['frames']} | {f['refresh_interval_ms']} "
                             f"| {f['interval_median_ms']} | {f['interval_p90_ms']} | {f['interval_max_ms']} "
                             f"| {f['late_frames']} |")
            else:
                lines.append(f"| {name} | {renderer} | no frames logged | | | | | |")
    lines += ["", "Smooth means the median equals the screen refresh and few frames are late.",
              "cairo is the default (less memory); if gl is clearly smoother here, Recto",
              "should use it on machines like this one (decision D50).", ""]
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(prog="collect-report", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", type=Path,
                        default=REPO / "reports" / "real-hardware" / time.strftime("%Y-%m-%d-%H%M"))
    parser.add_argument("--idle-seconds", type=int, default=60, help="wait before the idle measurement")
    args = parser.parse_args()

    if not os.environ.get("NIRI_SOCKET") or not os.environ.get("WAYLAND_DISPLAY"):
        print("collect-report: run this inside the Recto (niri) session.", file=sys.stderr)
        return 1
    if not SHELL.exists():
        print(f"collect-report: {SHELL} not found; run ./install.sh first.", file=sys.stderr)
        return 1
    out = args.out
    out.mkdir(parents=True, exist_ok=True)

    step("1/4  Machine and versions")
    info = system_info()
    (out / "system.json").write_text(json.dumps(info, indent=2, ensure_ascii=False) + "\n")

    step(f"2/4  Memory: leave the machine alone for {args.idle_seconds} s…")
    time.sleep(args.idle_seconds)
    mems = {"idle": measure(out, "idle", "idle: one terminal, nothing else")}
    shell("toggle-today")
    time.sleep(2)
    mems["today"] = measure(out, "today", "Today open")
    shell("toggle-today")
    print("      Today closed; waiting 30 s…", flush=True)
    time.sleep(30)
    mems["after"] = measure(out, "after", "30 s after closing Today")

    step("3/4  Frames: Today, Search, a notification and the volume open and close, twice…")
    frames = {}
    try:
        for renderer in ("cairo", "gl"):
            frames[renderer] = time_frames(out, renderer)
    finally:
        start_shell()   # back to normal, whatever happened
        time.sleep(1.5)
    (out / "frames.json").write_text(json.dumps(frames, indent=2) + "\n")

    step("4/4  Summary")
    text = summary(info, mems, frames)
    (out / "summary.md").write_text(text)
    print(text)
    print(f"Everything is in {out}. Look it over, then share the folder.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
